{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "telegram-employer-notifier",
	"account_id": "b80cae5df4b42938c936c16f09b84861",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-29",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"vars": {
		"CROSSCHEX_API_URL": "https://api.eu.crosschexcloud.com/",
		"ODOO_URL": "https://rpm-motos.odoo.com",
		// Usuario "Integracion asistencia": el Worker solo rehace las asistencias que creo el
		"ODOO_USER_ID": "15",
		// Dias hacia atras que trae la carga manual desde CrossChex (se pisa con --var al correrla)
		"RECONCILE_DAYS": "2"
	},
	"kv_namespaces": [
		{
			"binding": "EMPLOYEES",
			"id": "94e4f8001aed461babcc62d98563b9d7"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "telegram-employer-notifier",
			"database_id": "069dd629-92d9-404c-8c29-86b465627f7b",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "RATE_LIMITER",
				"class_name": "CrossChexRateLimiter"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_classes": ["CrossChexRateLimiter"]
		}
	]
}
